@using GestaoAcademia.Models
@model Plano

@{
    ViewData["Title"] = "Editar Plano";
}

<div class="form-card">

    <h2 class="mb-4">
        Editar Plano
    </h2>

    <form asp-controller="Plano"
          asp-action="Update"
          asp-route-id="@Model.IdPlano"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Nome do Plano
            </label>

            <input type="text"
                   name="NomePlano"
                   value="@Model.NomePlano"
                   class="form-control" />

        </div>

        <div class="mb-4">

            <label class="form-label">
                Valor do Plano
            </label>

            <input type="number"
                   name="ValorPlano"
                   value="@Model.ValorPlano"
                   class="form-control"
                   step="0.01" />

        </div>

        <button type="submit"
                class="btn btn-orange">
            Salvar alterações
        </button>

        <a asp-controller="Plano"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Cancelar
        </a>

    </form>

</div>