<!DOCTYPE html>

<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Academia Corpo e Alma</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <div class="sidebar">

        <div class="sidebar-logo">

            <div class="logo-ca">
                CA
            </div>

            <h2>
                Academia<br />
                Corpo e Alma
            </h2>

        </div>

        <nav class="sidebar-nav">

            <a asp-controller="Home"
               asp-action="Index">
                Início
            </a>

            <a asp-controller="Aluno"
               asp-action="Index">
                Alunos
            </a>

            <a asp-controller="Plano"
               asp-action="Index">
                Planos
            </a>


            <a asp-controller="Pagamento"
               asp-action="Index">
                Pagamentos
            </a>

            <a asp-controller="FichaTreino"
               asp-action="Index">
                Fichas de Treino
            </a>

            <a asp-controller="Exercicio"
               asp-action="Index">
                Exercícios
            </a>

        </nav>

    </div>

    <main class="main-content">

        <header class="page-header">

            <div>
                <h1>
                    @ViewData["Title"]
                </h1>

                <span>
                    Sistema de Gestão - Corpo e Alma
                </span>
            </div>

            @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Home")
            {
                <a href="/Home/Index"
                class="btn btn-outline-orange">
                    ← Voltar ao Início
                </a>
            }

        </header>

        @RenderBody()

    </main>

</body>

</html>