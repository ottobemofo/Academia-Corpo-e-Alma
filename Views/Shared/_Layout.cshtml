<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestão Academia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Academia</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <ul class="navbar-nav me-auto flex-row gap-3">
                <li class="nav-item"><a class="nav-link" asp-controller="Alunos" asp-action="Index">Alunos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Planos" asp-action="Index">Planos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Matriculas" asp-action="Index">Matrículas</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Pagamentos" asp-action="Index">Pagamentos</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Exercicios" asp-action="Index">Exercícios</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="FichasTreino" asp-action="Index">Fichas</a></li>
                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuários</a></li>
                }
            </ul>
            <form asp-controller="Conta" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                <span class="text-light small">@User.Identity.Name</span>
                <button class="btn btn-sm btn-outline-light">Sair</button>
            </form>
        }
    </div>
</nav>

<main class="container pb-5">
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">@TempData["Erro"]</div>
    }
    @RenderBody()
</main>
</body>
</html>
