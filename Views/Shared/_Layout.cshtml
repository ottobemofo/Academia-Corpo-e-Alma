<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestão Academia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="sidebar">
        <div class="sidebar-logo">
            <span class="logo-ca">CA</span>
            <h2>ACADEMIA CORPO E ALMA</h2>
        </div>
        <ul class="sidebar-nav">
            <li><a asp-controller="Home" asp-action="Index">Início</a></li>
            <li><a asp-controller="Alunos" asp-action="Index">Alunos</a></li>
            <li><a asp-controller="Planos" asp-action="Index">Planos</a></li>
            <li><a asp-controller="Matriculas" asp-action="Index">Matrículas</a></li>
            <li><a asp-controller="Pagamentos" asp-action="Index">Pagamentos</a></li>
            <li><a asp-controller="Exercicios" asp-action="Index">Exercícios</a></li>
            <li><a asp-controller="FichasTreino" asp-action="Index">Fichas</a></li>
            @if (User.IsInRole("Administrador"))
            {
                <li><a asp-controller="Usuarios" asp-action="Index">Usuários</a></li>
            }
        </ul>
    </div>
    <div class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>
            <div class="user-info">
                <span class="user-name">@User.Identity.Name</span>
                <form asp-controller="Conta" asp-action="Logout" method="post">
                    <button class="btn btn-orange btn-sm">Sair</button>
                </form>
            </div>
        </div>
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger alert-custom mb-3">@TempData["Erro"]</div>
        }
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-custom mb-3">@TempData["Sucesso"]</div>
        }
        @RenderBody()
    </div>
}
else
{
    @RenderBody()
}
</body>
</html>
