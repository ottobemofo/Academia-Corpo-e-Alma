@{
    ViewData["Title"] = "Entrar";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestão Academia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="login-container">
    <div class="login-card">
        <div class="text-center mb-4">
            <span class="logo-ca" style="font-size: 3rem; font-weight: 900; color: #ff6b35; display: block; margin-bottom: 10px;">CA</span>
            <h2 style="color: #333; font-weight: bold;">ACADEMIA CORPO E ALMA</h2>
        </div>
        @if (ViewData["Erro"] != null)
        {
            <div class="alert alert-danger alert-custom mb-3">@ViewData["Erro"]</div>
        }
        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="mb-3">
                <label class="form-label" for="email">E-mail</label>
                <input class="form-control" id="email" name="email" type="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="senha">Senha</label>
                <input class="form-control" id="senha" name="senha" type="password" required />
            </div>
            <button class="btn btn-orange w-100 py-2">Entrar</button>
        </form>
    </div>
</body>
</html>
