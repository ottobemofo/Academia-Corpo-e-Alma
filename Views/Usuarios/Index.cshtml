@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuários";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuários</h1>
    <a asp-action="Create" class="btn btn-primary">Novo</a>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Nome)</td>
            <td>@(item.Email)</td>
            <td>@(item.Perfil)</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
