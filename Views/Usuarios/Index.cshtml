@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuários do app";
}
<div class="page-description">
    Cadastro dos usuários que podem acessar o sistema: atendentes, gerentes e dono.
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="form-section">
            <h3>Usuários cadastrados</h3>
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>NOME</th>
                            <th>E-MAIL</th>
                            <th>PERFIL</th>
                            <th>AÇÃO</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Nome)</td>
                            <td>@(item.Email)</td>
                            <td>@(item.Perfil)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-orange">Ver</a>
                                <a asp-action="Edit" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="form-section">
            <h3>Cadastrar usuário</h3>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input class="form-control" name="Nome" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input class="form-control" name="Email" type="email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Perfil</label>
                    <select class="form-select" name="Perfil">
                        <option value="Atendente">Atendente</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <input class="form-control" name="Senha" type="password" required />
                </div>
                <button type="submit" class="btn btn-orange w-100">Cadastrar</button>
            </form>
        </div>
    </div>
</div>
