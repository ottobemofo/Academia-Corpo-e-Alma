@using GestaoAcademia.Models
@model AlunoFormViewModel

@{
    ViewData["Title"] = "Editar Aluno";

    List<Plano> planos =
        ViewBag.Planos as List<Plano>
        ?? new List<Plano>();

    List<Usuario> funcionarios =
        ViewBag.Funcionarios as List<Usuario>
        ?? new List<Usuario>();
}

<div class="form-card">

    <h2 class="mb-4">
        Editar Aluno
    </h2>

    <form action="/Aluno/Update/@Model.IdPessoa"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Nome
            </label>

            <input type="text"
                   name="Nome"
                   value="@Model.Nome"
                   class="form-control"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Telefone
            </label>

            <input type="text"
                   name="Telefone"
                   value="@Model.Telefone"
                   class="form-control"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Plano
            </label>

            <select name="IdPlano"
                    class="form-select"
                    required>

                @foreach (Plano plano in planos)
                {
                    if (plano.IdPlano == Model.IdPlano)
                    {
                        <option value="@plano.IdPlano" selected>
                            @plano.NomePlano - R$ @plano.ValorPlano.ToString("N2")
                        </option>
                    }
                    else
                    {
                        <option value="@plano.IdPlano">
                            @plano.NomePlano - R$ @plano.ValorPlano.ToString("N2")
                        </option>
                    }
                }

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Dia de vencimento
            </label>

            <input type="number"
                   name="DiaPagamento"
                   value="@Model.DiaPagamento"
                   class="form-control"
                   min="1"
                   max="31"
                   required />

        </div>


        <div class="mb-4">

            <label class="form-label">
                Funcionário responsável
            </label>

            <select name="IdUsuario"
                    class="form-select"
                    required>

                @foreach (Usuario funcionario in funcionarios)
                {
                    if (funcionario.IdPessoa == Model.IdUsuario)
                    {
                        <option value="@funcionario.IdPessoa"
                                selected>
                            @funcionario.Nome
                        </option>
                    }
                    else
                    {
                        <option value="@funcionario.IdPessoa">
                            @funcionario.Nome
                        </option>
                    }
                }

            </select>

        </div>


        <button type="submit"
                class="btn btn-orange">

            Salvar Alterações

        </button>


        <a href="/Aluno/Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>