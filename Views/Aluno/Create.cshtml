@using GestaoAcademia.Models
@model AlunoFormViewModel

@{
    ViewData["Title"] = "Cadastrar Aluno";
}

<div class="form-card">

    <h2 class="mb-4">
        Novo Aluno
    </h2>


    <form action="/Aluno/Create"
          method="post">


        <div class="mb-3">

            <label class="form-label">
                Nome
            </label>

            <input type="text"
                   name="Nome"
                   class="form-control"
                   placeholder="Digite o nome do aluno"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Telefone
            </label>

            <input type="text"
                   name="Telefone"
                   class="form-control"
                   placeholder="(17) 99999-9999"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Plano
            </label>

            <select name="IdPlano"
                    class="form-select"
                    required>

                <option value="">
                    Selecione o plano
                </option>

                <option value="1">
                    3 vezes por semana
                </option>

                <option value="2">
                    Todos os dias
                </option>

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Dia de vencimento
            </label>

            <input type="number"
                   name="DiaPagamento"
                   class="form-control"
                   min="1"
                   max="31"
                   placeholder="Ex: 10"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Último pagamento
            </label>

            <input type="date"
                   name="UltimoPagamento"
                   class="form-control" />

        </div>


        <div class="mb-4">

            <label class="form-label">
                Funcionário responsável
            </label>

            <input type="number"
                   name="IdUsuario"
                   class="form-control"
                   placeholder="ID do funcionário"
                   required />

        </div>


        <button type="submit"
                class="btn btn-orange">

            Cadastrar Aluno

        </button>


        <a href="/Aluno/Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>