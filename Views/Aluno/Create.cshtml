@using GestaoAcademia.Models
@model AlunoFormViewModel

@{
    ViewData["Title"] = "Cadastrar Aluno";

    List<Plano> planos =
        ViewBag.Planos as List<Plano>
        ?? new List<Plano>();

    List<Usuario> funcionarios =
        ViewBag.Funcionarios as List<Usuario>
        ?? new List<Usuario>();
}

<div class="form-card">

    <h2 class="mb-4">
        Novo Aluno
    </h2>

    <form action="/Aluno/Create"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Nome
            </label>

            <input type="text"
                   name="Nome"
                   class="form-control"
                   placeholder="Digite o nome do aluno"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Telefone
            </label>

            <input type="text"
                   name="Telefone"
                   class="form-control"
                   placeholder="(17) 99999-9999"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Plano
            </label>

            <select name="IdPlano"
                    class="form-select"
                    required>

                <option value="">
                    Selecione o plano
                </option>

                @foreach (Plano plano in planos)
                {
                    <option value="@plano.IdPlano">
                        @plano.NomePlano - R$ @plano.ValorPlano.ToString("N2")
                    </option>
                }

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Dia de vencimento
            </label>

            <input type="number"
                   name="DiaPagamento"
                   class="form-control"
                   min="1"
                   max="31"
                   required />

        </div>



        <div class="mb-4">

            <label class="form-label">
                Funcionário responsável
            </label>

            <select name="IdUsuario"
                    class="form-select"
                    required>

                <option value="">
                    Selecione o funcionário
                </option>

                @foreach (Usuario funcionario in funcionarios)
                {
                    <option value="@funcionario.IdPessoa">
                        @funcionario.Nome
                    </option>
                }

            </select>

        </div>


        <button type="submit"
                class="btn btn-orange">

            Cadastrar Aluno

        </button>


        <a href="/Aluno/Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>