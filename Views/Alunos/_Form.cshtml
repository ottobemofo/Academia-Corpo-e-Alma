@model Aluno

<div class="mb-3">
    <label asp-for="Nome" class="form-label"></label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Telefone" class="form-label"></label>
    <input asp-for="Telefone" class="form-control" />
    <span asp-validation-for="Telefone" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="StatusAluno" class="form-label"></label>
    <select asp-for="StatusAluno" asp-items="Html.GetEnumSelectList<StatusAluno>()" class="form-select"></select>
    <span asp-validation-for="StatusAluno" class="text-danger"></span>
</div>
