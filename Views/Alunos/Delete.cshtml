@model Aluno
@{
    ViewData["Title"] = "Excluir - Alunos";
}
<h1 class="h3 mb-3">Excluir este registro?</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@(Model.Nome)</dd>
    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@(Model.Telefone)</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.StatusAluno)</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdPessoa" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
