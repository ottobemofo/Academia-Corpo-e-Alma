@model IEnumerable<Aluno>
@{
    ViewData["Title"] = "Alunos";
}
<div class="page-description">
    Tabela ajustada para a rotina real da academia: modalidade do aluno, dia combinado para pagamento, último pagamento, atraso e atendente responsável.
</div>

<div class="search-box">
    <input type="text" placeholder="Buscar por aluno, telefone, modalidade ou atendente" id="searchInput" onkeyup="filterTable()" />
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Create" class="btn btn-orange">+ Novo Aluno</a>
</div>

<div class="table-responsive">
<table class="table table-custom align-middle" id="alunosTable">
    <thead>
        <tr>
            <th>ALUNO</th>
            <th>TELEFONE</th>
            <th>MODALIDADE</th>
            <th>DIA PGTO</th>
            <th>ÚLTIMO PGTO</th>
            <th>MESES ATRASO</th>
            <th>ATENDENTE</th>
            <th>STATUS</th>
            <th>AÇÃO</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.Nome)</td>
            <td>@(item.Telefone)</td>
            <td>@(item.Matriculas.FirstOrDefault()?.Plano?.NomePlano ?? "—")</td>
            <td>@(item.Matriculas.FirstOrDefault()?.DiaPagamento.ToString() ?? "—")</td>
            <td>@(item.Matriculas.FirstOrDefault()?.UltimoPagamento?.ToString("dd/MM/yyyy") ?? "—")</td>
            <td>@(item.Matriculas.FirstOrDefault()?.MesesEmAtraso ?? 0)</td>
            <td>@(item.Matriculas.FirstOrDefault()?.Usuario?.Nome ?? "—")</td>
            <td>
                @if (item.StatusAluno == StatusAluno.Ativo)
                {
                    <span class="status-em-dia">Em dia</span>
                }
                else
                {
                    <span class="status-atrasado">Atrasado</span>
                }
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-orange">Ver</a>
                <a asp-action="Edit" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdPessoa" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<script>
function filterTable() {
    var input, filter, table, tr, td, i, txtValue;
    input = document.getElementById("searchInput");
    filter = input.value.toUpperCase();
    table = document.getElementById("alunosTable");
    tr = table.getElementsByTagName("tr");
    
    for (i = 1; i < tr.length; i++) {
        var visible = false;
        var tds = tr[i].getElementsByTagName("td");
        for (var j = 0; j < tds.length; j++) {
            if (tds[j]) {
                txtValue = tds[j].textContent || tds[j].innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    visible = true;
                    break;
                }
            }
        }
        tr[i].style.display = visible ? "" : "none";
    }
}
</script>
