@model Aluno
@{
    ViewData["Title"] = "Detalhes - Alunos";
}
<h1 class="h3 mb-3">Detalhes - Alunos</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@(Model.Nome)</dd>
    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@(Model.Telefone)</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@(Model.StatusAluno)</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdPessoa" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-link">Voltar</a>
