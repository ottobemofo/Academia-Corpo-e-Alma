@using GestaoAcademia.Models
@model Matricula

@{
    ViewData["Title"] = "Editar Matrícula";
}

<div class="form-card">

    <h2 class="mb-4">
        Editar Matrícula
    </h2>

    <form asp-controller="Matricula"
          asp-action="Update"
          asp-route-id="@Model.IdMatricula"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Aluno
            </label>

            <input type="number"
                   name="IdAluno"
                   value="@Model.IdAluno"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Plano
            </label>

            <input type="number"
                   name="IdPlano"
                   value="@Model.IdPlano"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Usuário responsável
            </label>

            <input type="number"
                   name="IdUsuario"
                   value="@Model.IdUsuario"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Data da Matrícula
            </label>

            <input type="date"
                   name="DataMatricula"
                   value="@Model.DataMatricula.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>

        <div class="mb-4">

            <label class="form-label">
                Dia do Pagamento
            </label>

            <input type="number"
                   name="DiaPagamento"
                   value="@Model.DiaPagamento"
                   min="1"
                   max="31"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-orange">

            Salvar alterações

        </button>

        <a asp-controller="Matricula"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>