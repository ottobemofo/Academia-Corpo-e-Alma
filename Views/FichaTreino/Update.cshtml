@using GestaoAcademia.Models
@model FichaTreino

@{
    ViewData["Title"] = "Editar Ficha de Treino";

    List<Aluno> alunos =
        ViewBag.Alunos as List<Aluno>
        ?? new List<Aluno>();

    List<Usuario> usuarios =
        ViewBag.Usuarios as List<Usuario>
        ?? new List<Usuario>();

    List<Exercicio> exercicios =
        ViewBag.Exercicios as List<Exercicio>
        ?? new List<Exercicio>();

    List<int> exerciciosSelecionados =
        ViewBag.ExerciciosSelecionados as List<int>
        ?? new List<int>();
}


<div class="form-card">

    <h2 class="mb-4">
        Editar Ficha de Treino
    </h2>


    <form asp-controller="FichaTreino"
          asp-action="Update"
          asp-route-id="@Model.IdTreino"
          method="post">


        <div class="mb-3">

            <label class="form-label">
                Nome do Treino
            </label>

            <input type="text"
                   name="NomeTreino"
                   value="@Model.NomeTreino"
                   class="form-control"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Aluno
            </label>

            <select name="IdAluno"
                    class="form-select"
                    required>

                @foreach (Aluno aluno in alunos)
                {
                    if (aluno.IdPessoa ==
                        Model.IdAluno)
                    {
                        <option value="@aluno.IdPessoa"
                                selected>

                            @aluno.Nome

                        </option>
                    }
                    else
                    {
                        <option value="@aluno.IdPessoa">

                            @aluno.Nome

                        </option>
                    }
                }

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Responsável pelo treino
            </label>

            <select name="IdUsuario"
                    class="form-select"
                    required>

                @foreach (Usuario usuario
                    in usuarios)
                {
                    if (usuario.IdPessoa ==
                        Model.IdUsuario)
                    {
                        <option value="@usuario.IdPessoa"
                                selected>

                            @usuario.Nome -
                            @usuario.Perfil

                        </option>
                    }
                    else
                    {
                        <option value="@usuario.IdPessoa">

                            @usuario.Nome -
                            @usuario.Perfil

                        </option>
                    }
                }

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Data de Criação
            </label>

            <input type="date"
                   name="DataCriacao"
                   value="@Model.DataCriacao.ToString("yyyy-MM-dd")"
                   class="form-control"
                   required />

        </div>


        <div class="mb-3">

            <label class="form-label">
                Objetivo
            </label>

            <input type="text"
                   name="Objetivo"
                   value="@Model.Objetivo"
                   class="form-control"
                   required />

        </div>


        <div class="mb-4">

            <label class="form-label">
                Exercícios
            </label>


            <div class="border rounded p-3">

                @foreach (Exercicio exercicio
                    in exercicios)
                {
                    bool selecionado =
                        exerciciosSelecionados.Contains(
                            exercicio.IdExercicio
                        );


                    <div class="form-check mb-2">

                        @if (selecionado)
                        {
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="IdExercicios"
                                   value="@exercicio.IdExercicio"
                                   id="exercicio_@exercicio.IdExercicio"
                                   checked />
                        }
                        else
                        {
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="IdExercicios"
                                   value="@exercicio.IdExercicio"
                                   id="exercicio_@exercicio.IdExercicio" />
                        }


                        <label class="form-check-label"
                               for="exercicio_@exercicio.IdExercicio">

                            <strong>
                                @exercicio.NomeExercicio
                            </strong>

                            -

                            @exercicio.GrupoMuscular

                            (@exercicio.Series séries x
                            @exercicio.Repeticoes repetições)

                        </label>

                    </div>
                }

            </div>

        </div>


        <button type="submit"
                class="btn btn-orange">

            Salvar alterações

        </button>


        <a asp-controller="FichaTreino"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>