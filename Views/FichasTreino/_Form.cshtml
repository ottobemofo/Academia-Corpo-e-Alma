@model FichaTreino

<div class="mb-3">
    <label asp-for="NomeTreino" class="form-label"></label>
    <input asp-for="NomeTreino" class="form-control" />
    <span asp-validation-for="NomeTreino" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="AlunoId" class="form-label"></label>
    <select asp-for="AlunoId" asp-items="(SelectList)ViewBag.Alunos" class="form-select">
        <option value="0">Selecione...</option>
    </select>
    <span asp-validation-for="AlunoId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Objetivo" class="form-label"></label>
    <input asp-for="Objetivo" class="form-control" />
    <span asp-validation-for="Objetivo" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Series" class="form-label"></label>
    <input asp-for="Series" type="number" class="form-control" />
    <span asp-validation-for="Series" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Repeticoes" class="form-label"></label>
    <input asp-for="Repeticoes" type="number" class="form-control" />
    <span asp-validation-for="Repeticoes" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CargaKg" class="form-label"></label>
    <input asp-for="CargaKg" type="text" class="form-control" />
    <span asp-validation-for="CargaKg" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DataCriacao" class="form-label"></label>
    <input asp-for="DataCriacao" type="date" class="form-control" />
    <span asp-validation-for="DataCriacao" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ExerciciosIds" class="form-label"></label>
    <select asp-for="ExerciciosIds" asp-items="(SelectList)ViewBag.Exercicios" class="form-select" size="8"></select>
    <div class="form-text">Segure Ctrl (ou Cmd) para marcar vários.</div>
    <span asp-validation-for="ExerciciosIds" class="text-danger"></span>
</div>
<input asp-for="UsuarioId" type="hidden" />
