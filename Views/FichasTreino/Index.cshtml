@model IEnumerable<FichaTreino>
@{
    ViewData["Title"] = "Fichas de treino";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Fichas de treino</h1>
    <a asp-action="Create" class="btn btn-primary">Novo</a>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Treino</th><th>Aluno</th><th>Objetivo</th><th>Séries</th><th>Repetições</th><th>Carga (kg)</th><th>Exercícios</th><th>Criada em</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.NomeTreino)</td>
            <td>@(item.Aluno?.Nome)</td>
            <td>@(item.Objetivo)</td>
            <td>@(item.Series)</td>
            <td>@(item.Repeticoes)</td>
            <td>@(item.CargaKg)</td>
            <td>@(string.Join(", ", item.Exercicios.Select(e => e.NomeExercicio)))</td>
            <td>@(item.DataCriacao.ToString("dd/MM/yyyy"))</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.IdTreino" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.IdTreino" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdTreino" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
