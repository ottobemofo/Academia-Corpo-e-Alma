@{
    ViewData["Title"] = "Início";
}

<div class="row g-4">

  
    <div class="col-md-4">
        <div class="card-custom home-card">

            <h2>Alunos</h2>

            <p>
                Cadastro e gerenciamento dos alunos da academia.
            </p>

            <a href="/Aluno/Index"
               class="btn btn-orange">
                Acessar alunos
            </a>

        </div>
    </div>


    
    <div class="col-md-4">
        <div class="card-custom home-card">

            <h2>Pagamentos</h2>

            <p>
                Registre e consulte pagamentos dos alunos.
            </p>

            <a href="/Pagamento/Index"
               class="btn btn-orange">
                Acessar pagamentos
            </a>

        </div>
    </div>



    <div class="col-md-4">
        <div class="card-custom home-card">

            <h2>Planos</h2>

            <p>
                Consulte os planos disponíveis.
            </p>

            <a href="/Plano/Index"
               class="btn btn-orange">
                Ver planos
            </a>

        </div>
    </div>

</div>



<div class="row g-4 mt-1 justify-content-center">

  
    <div class="col-md-4">
        <div class="card-custom home-card">

            <h2>Fichas de Treino</h2>

            <p>
                Consulte as fichas dos alunos.
            </p>

            <a href="/FichaTreino/Index"
               class="btn btn-outline-orange">
                Ver fichas
            </a>

        </div>
    </div>


    
    <div class="col-md-4">
        <div class="card-custom home-card">

            <h2>Exercícios</h2>

            <p>
                Gerencie os exercícios utilizados nas fichas.
            </p>

            <a href="/Exercicio/Index"
               class="btn btn-outline-orange">
                Ver exercícios
            </a>

        </div>
    </div>

</div>