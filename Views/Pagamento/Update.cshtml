@using GestaoAcademia.Models
@model Pagamento

@{
    ViewData["Title"] = "Editar Pagamento";

    Dictionary<int, string> alunosMatriculas =
        ViewBag.AlunosMatriculas as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="form-card">

    <h2 class="mb-4">
        Editar Pagamento
    </h2>

    <form asp-controller="Pagamento"
          asp-action="Update"
          asp-route-id="@Model.IdPagamento"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Aluno
            </label>

            <select name="IdMatricula"
                    class="form-select"
                    required>

                @foreach (KeyValuePair<int, string> item in alunosMatriculas)
                {
                    if (item.Key == Model.IdMatricula)
                    {
                        <option value="@item.Key" selected>
                            @item.Value
                        </option>
                    }
                    else
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }
                }

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Data do Pagamento
            </label>

            <input type="date"
                   name="DataPagamento"
                   value="@Model.DataPagamento.ToString("yyyy-MM-dd")"
                   class="form-control"
                   required />

        </div>


        <div class="mb-4">

            <label class="form-label">
                Forma de Pagamento
            </label>

            <select name="FormaPagamento"
                    class="form-select"
                    required>

                @if (Model.FormaPagamento.ToUpper() == "PIX")
                {
                    <option value="PIX" selected>
                        PIX
                    </option>

                    <option value="DINHEIRO">
                        Dinheiro
                    </option>
                }
                else
                {
                    <option value="PIX">
                        PIX
                    </option>

                    <option value="DINHEIRO" selected>
                        Dinheiro
                    </option>
                }

            </select>

        </div>


        <button type="submit"
                class="btn btn-orange">

            Salvar alterações

        </button>


        <a asp-controller="Pagamento"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>