@using GestaoAcademia.Models
@model List<Pagamento>

@{
    ViewData["Title"] = "Pagamentos";
}

<div class="card-custom">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Pagamentos registrados</h2>

            <span class="text-muted">
                Consulte e gerencie os pagamentos dos alunos.
            </span>
        </div>

        <a asp-controller="Pagamento"
           asp-action="Create"
           class="btn btn-orange">
            + Novo Pagamento
        </a>

    </div>

    <div class="table-responsive">

        <table class="table table-custom">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Matrícula</th>
                    <th>Data do Pagamento</th>
                    <th>Forma de Pagamento</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (Pagamento pagamento in Model)
                {
                    <tr>

                        <td>
                            @pagamento.IdPagamento
                        </td>

                        <td>
                            @pagamento.IdMatricula
                        </td>

                        <td>
                            @pagamento.DataPagamento.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @pagamento.FormaPagamento
                        </td>

                        <td>

                            <a asp-controller="Pagamento"
                               asp-action="Update"
                               asp-route-id="@pagamento.IdPagamento"
                               class="btn btn-sm btn-outline-orange">
                                Editar
                            </a>

                            <a asp-controller="Pagamento"
                               asp-action="Delete"
                               asp-route-id="@pagamento.IdPagamento"
                               class="btn btn-sm btn-outline-danger">
                                Excluir
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>