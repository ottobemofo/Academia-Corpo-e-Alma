@using GestaoAcademia.Models
@model Pagamento

@{
    ViewData["Title"] = "Registrar Pagamento";

    Dictionary<int, string> alunosMatriculas =
        ViewBag.AlunosMatriculas as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="form-card">

    <h2 class="mb-4">
        Novo Pagamento
    </h2>

    <form action="/Pagamento/Create"
          method="post">

        <div class="mb-3">

            <label class="form-label">
                Aluno
            </label>

            <select name="IdMatricula"
                    class="form-select"
                    required>

                <option value="">
                    Selecione o aluno
                </option>

                @foreach (KeyValuePair<int, string> item in alunosMatriculas)
                {
                    <option value="@item.Key">
                        @item.Value
                    </option>
                }

            </select>

        </div>


        <div class="mb-3">

            <label class="form-label">
                Data do Pagamento
            </label>

            <input type="date"
                   name="DataPagamento"
                   class="form-control"
                   required />

        </div>


        <div class="mb-4">

            <label class="form-label">
                Forma de Pagamento
            </label>

            <select name="FormaPagamento"
                    class="form-select"
                    required>

                <option value="">
                    Selecione
                </option>

                <option value="PIX">
                    PIX
                </option>

                <option value="DINHEIRO">
                    Dinheiro
                </option>

            </select>

        </div>


        <button type="submit"
                class="btn btn-orange">

            Salvar

        </button>


        <a href="/Pagamento/Index"
           class="btn btn-outline-secondary">

            Cancelar

        </a>

    </form>

</div>