@model Plano

<div class="mb-3">
    <label asp-for="NomePlano" class="form-label"></label>
    <input asp-for="NomePlano" class="form-control" />
    <span asp-validation-for="NomePlano" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descricao" class="form-label"></label>
    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descricao" class="text-danger"></span>
</div>
<div class="form-check mb-3">
    <input asp-for="StatusPlano" class="form-check-input" />
    <label asp-for="StatusPlano" class="form-check-label"></label>
</div>
