@model Plano
@{
    ViewData["Title"] = "Detalhes - Planos";
}
<h1 class="h3 mb-3">Detalhes - Planos</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@(Model.NomePlano)</dd>
    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@(Model.Descricao)</dd>
    <dt class="col-sm-3">Ativo</dt>
    <dd class="col-sm-9">@((Model.StatusPlano ? "Sim" : "Não"))</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.IdPlano" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-link">Voltar</a>
