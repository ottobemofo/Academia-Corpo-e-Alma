@model IEnumerable<Plano>
@{
    ViewData["Title"] = "Planos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Planos</h1>
    <a asp-action="Create" class="btn btn-primary">Novo</a>
</div>

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Nome</th><th>Descrição</th><th>Ativo</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@(item.NomePlano)</td>
            <td>@(item.Descricao)</td>
            <td>@((item.StatusPlano ? "Sim" : "Não"))</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@item.IdPlano" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                <a asp-action="Edit" asp-route-id="@item.IdPlano" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdPlano" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
