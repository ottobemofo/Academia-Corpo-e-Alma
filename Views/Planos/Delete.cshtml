@model Plano
@{
    ViewData["Title"] = "Excluir - Planos";
}
<h1 class="h3 mb-3">Excluir este registro?</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@(Model.NomePlano)</dd>
    <dt class="col-sm-3">Descrição</dt>
    <dd class="col-sm-9">@(Model.Descricao)</dd>
    <dt class="col-sm-3">Ativo</dt>
    <dd class="col-sm-9">@((Model.StatusPlano ? "Sim" : "Não"))</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdPlano" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
