@model Matricula
@{
    ViewData["Title"] = "Detalhes da matrícula";
}
<h1 class="h3 mb-3">Matrícula #@Model.IdMatricula</h1>

<dl class="row">
    <dt class="col-sm-3">Aluno</dt><dd class="col-sm-9">@Model.Aluno?.Nome</dd>
    <dt class="col-sm-3">Plano</dt><dd class="col-sm-9">@Model.Plano?.NomePlano</dd>
    <dt class="col-sm-3">Data da matrícula</dt><dd class="col-sm-9">@Model.DataMatricula.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Dia do pagamento</dt><dd class="col-sm-9">@Model.DiaPagamento</dd>
    <dt class="col-sm-3">Último pagamento</dt><dd class="col-sm-9">@(Model.UltimoPagamento?.ToString("dd/MM/yyyy") ?? "—")</dd>
    <dt class="col-sm-3">Meses em atraso</dt><dd class="col-sm-9">@Model.MesesEmAtraso</dd>
    <dt class="col-sm-3">Observação</dt><dd class="col-sm-9">@Model.Observacao</dd>
    <dt class="col-sm-3">Registrada por</dt><dd class="col-sm-9">@Model.Usuario?.Nome</dd>
</dl>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h2 class="h5 mb-0">Pagamentos</h2>
    <a asp-controller="Pagamentos" asp-action="Create" asp-route-matriculaId="@Model.IdMatricula" class="btn btn-success btn-sm">Registrar pagamento</a>
</div>
<table class="table table-sm">
    <thead><tr><th>Data</th><th>Valor</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Pagamentos.OrderByDescending(p => p.DataPagamento))
    {
        <tr>
            <td>@p.DataPagamento.ToString("dd/MM/yyyy")</td>
            <td>@p.ValorPago.ToString("C")</td>
            <td class="text-end"><a asp-controller="Pagamentos" asp-action="Edit" asp-route-id="@p.IdPagamento" class="btn btn-sm btn-outline-secondary">Editar</a></td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Edit" asp-route-id="@Model.IdMatricula" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-link">Voltar</a>
